# Copy these NAMES into Vercel -> Project -> Settings -> Environment Variables (Production).
# Never put real values in this file or in the repository.

# ---- Persistent history ("Recently Played"): Upstash Redis (free plan) ----
# Created for you when you add Upstash Redis from the Vercel Marketplace (Storage tab); or copy them from console.upstash.com -> your database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Real banner + accent colour (OPTIONAL but needed to show your banner) ----
# Token of a Discord BOT you create (Developer Portal -> New Application -> Bot -> Reset Token). It needs no permissions and does not have to join any server.
# It is used only on the server to call Discord's official GET /users/{id}. It is NOT your account token.
DISCORD_BOT_TOKEN=

# ---- Optional ----
# Your numeric Discord ID. If empty, the one already used by the site is used.
DISCORD_USER_ID=
# Lets an external scheduler record songs while nobody is on the site: it calls /api/track with the header  Authorization: Bearer <value>  (16+ characters).
TRACK_SECRET=
